<?xml version="1.0" encoding="utf-8"?>
<!--
  What .NET unit-test coverage counts (Microsoft.Testing.Extensions.CodeCoverage, passed with coverage-settings).
  Left out: source-generated files, EF Core migrations and Program.cs startup wiring, which the integration tests exercise.
-->
<Configuration>
  <Format>cobertura</Format>
  <CodeCoverage>
    <ModulePaths>
      <Include>
        <ModulePath>.*MyPoGoCompanion\..*\.dll$</ModulePath>
      </Include>
      <Exclude>
        <ModulePath>.*Tests\.dll$</ModulePath>
      </Exclude>
    </ModulePaths>
    <Sources>
      <Exclude>
        <Source>.*\.g\.cs$</Source>
        <Source>.*\.generated\.cs$</Source>
        <Source>.*[\\/]Program\.cs$</Source>
        <Source>.*[\\/]Migrations[\\/].*\.cs$</Source>
      </Exclude>
    </Sources>
    <Attributes>
      <Exclude>
        <Attribute>^System\.Diagnostics\.CodeAnalysis\.ExcludeFromCodeCoverageAttribute$</Attribute>
        <Attribute>^System\.CodeDom\.Compiler\.GeneratedCodeAttribute$</Attribute>
      </Exclude>
    </Attributes>
  </CodeCoverage>
</Configuration>
