<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Local sign-in secrets live outside the repository: dotnet user-secrets (docs/SIGN-IN.md). -->
    <UserSecretsId>mypogocompanion-api</UserSecretsId>
    <!-- XML comments become descriptions in the OpenAPI document; not every public type needs one. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!--
    The OpenAPI document is written to api/openapi.json on every Debug build, so a change to the API shows up in
    `git status` and is committed with it. Release builds (CI, Docker) leave it alone unless asked with
    -p:UpdateOpenApi=true, which the contract check does before comparing (docs/API.md).
  -->
  <PropertyGroup>
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/..</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name openapi</OpenApiGenerateDocumentsOptions>
    <OpenApiGenerateDocuments Condition="'$(Configuration)' != 'Debug' and '$(UpdateOpenApi)' != 'true'">false</OpenApiGenerateDocuments>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.DependencyInjection" />
    <PackageReference Include="Scalar.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MyPoGoCompanion.Data\MyPoGoCompanion.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MyPoGoCompanion.Api.UnitTests" />
  </ItemGroup>

</Project>
